APP_NAME=FashionMart
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Business defaults — read via config('app.currency') etc. Never hard-code in controllers.
APP_CURRENCY=BDT
APP_CURRENCY_SYMBOL=৳

LOG_CHANNEL=daily
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fashionmart
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_DOMAIN=localhost

CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=public

# Frontend origin(s) allowed by CORS — comma separated, used by config/cors.php
FRONTEND_URL=http://localhost:5173

# Unused while auth is Bearer-token only (see config/sanctum.php); left here
# in case a cookie-based session is ever reintroduced deliberately.
SANCTUM_STATEFUL_DOMAINS=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@fashionmart.test"
MAIL_FROM_NAME="${APP_NAME}"

# Pagination default (items per page) — configurable, read via config('app.pagination_size')
APP_PAGINATION_SIZE=15
